{
  "key": "vmware_esxlog_esxcli@kvp::__extraction__",
  "sourcetype": "vmware_esxlog_esxcli@kvp",
  "dest_format": "__extraction__",
  "score": 100,
  "part": "extraction",
  "author": "unknown",
  "build": 829,
  "updated_at": "2026-09-29T16:00:24.775Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse ESXi esxcli log line into structured fields: timestamp, host, pid, opID, user, source IP, command, result, and optional reason/severity",
      "conf": {
        "source": "_raw",
        "regex": "/^(?<timestamp>\\S+)\\s+(?<dst_host>\\S+)\\s+Esxcli:\\s+(?<pid>\\d+)\\s+opID=(?<opid>\\S+)\\s+user=(?<user>\\S+)\\s+source=(?<src_ip>\\S+)\\s+cmd='(?<message>[^']+)'\\s+result=(?<result>\\S+)(?:\\s+reason='(?<reason>[^']+)')?(?:\\s+severity=(?<severity>\\S+))?/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Normalize action field from result, default severity when not present in raw event",
      "conf": {
        "add": [
          {
            "name": "action",
            "value": "result === 'Success' ? 'allowed' : 'blocked'"
          },
          {
            "name": "vendor_severity",
            "value": "severity || undefined"
          },
          {
            "name": "severity",
            "value": "severity ? severity : (result === 'Failed' ? 'ERROR' : 'INFO')"
          },
          {
            "name": "protocol",
            "value": "'esxcli'"
          }
        ]
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Flag whether source IP is IPv6 for downstream handling",
      "conf": {
        "add": [
          {
            "name": "__src_is_ipv6",
            "value": "src_ip && src_ip.indexOf(':') !== -1 ? true : false"
          }
        ]
      }
    }
  ],
  "recipe": {
    "fingerprint": {
      "format": "kvp",
      "keys": [
        "cmd",
        "opid",
        "reason",
        "result",
        "severity",
        "source",
        "user"
      ]
    }
  },
  "report": null,
  "wireFormat": "kvp"
}