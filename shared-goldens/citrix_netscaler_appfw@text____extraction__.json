{
  "key": "citrix_netscaler_appfw@text::__extraction__",
  "sourcetype": "citrix_netscaler_appfw@text",
  "dest_format": "__extraction__",
  "score": 92,
  "part": "extraction",
  "author": "unknown",
  "build": 829,
  "updated_at": "2026-09-29T15:51:58.425Z",
  "functions": [
    {
      "id": "regex_extract",
      "filter": "true",
      "disabled": false,
      "description": "Parse Citrix NetScaler AppFW log line into structured fields",
      "conf": {
        "source": "_raw",
        "regex": "/^\\S+\\s+\\d+\\s+[\\d:]+\\s+\\S+\\s+(?<timestamp>\\d{2}\\/\\d{2}\\/\\d{4}:\\d{2}:\\d{2}:\\d{2})\\s+GMT\\s+\\S+\\s+(?<ppe>[\\w-]+)\\s+:\\s+APPFW\\s+(?<signature_type>\\S+)\\s+(?<result>\\S+)\\s+(?<session_id>\\d+)\\s+(?<seq>\\d+)\\s+:\\s+(?<src_ip>[0-9a-fA-F.:]+)\\s+(?:(?<src_port>\\d+)-(?<dst_port>\\d+)|-)\\s+(?<profile>\\S+)\\s+(?:(?<http_method>\\S+)\\s+(?<url>\\S+)|-)\\s+(?<policy_name>\\S+)\\s+(?<signature_name>\\S+)\\s+(?<severity>\\S+)\\s+(?<action>\\S+)\\s+threat_index=(?<threat_index>[\\d.]+)\\s+status=(?<status_code>\\d+)$/",
        "iterations": 1,
        "overwrite": false
      }
    },
    {
      "id": "eval",
      "filter": "true",
      "disabled": false,
      "description": "Normalize severity/action casing and add protocol field",
      "conf": {
        "add": [
          {
            "name": "protocol",
            "value": "'tcp'"
          },
          {
            "name": "vendor_severity",
            "value": "severity || undefined"
          },
          {
            "name": "severity",
            "value": "severity ? severity.toLowerCase() : severity"
          },
          {
            "name": "vendor_action",
            "value": "action || undefined"
          },
          {
            "name": "action",
            "value": "action ? action.toLowerCase() : action"
          },
          {
            "name": "threat_index",
            "value": "threat_index ? Number(threat_index) : threat_index"
          },
          {
            "name": "status_code",
            "value": "status_code ? Number(status_code) : status_code"
          }
        ]
      }
    }
  ],
  "recipe": {
    "fingerprint": {
      "format": "kvp",
      "keys": [
        "field",
        "field_len",
        "size",
        "status",
        "threat_index"
      ]
    }
  },
  "report": null,
  "wireFormat": "text"
}